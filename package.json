{
  "name": "@convex-dev/stripe",
  "description": "A stripe component for Convex.",
  "repository": "github:ethan-huo/stripe",
  "homepage": "https://github.com/ethan-huo/stripe#readme",
  "bugs": {
    "url": "https://github.com/ethan-huo/stripe/issues"
  },
  "version": "0.1.5",
  "packageManager": "bun@1.3.13",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'bun run dev:codegen'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:codegen": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'bun run codegen' --initial",
    "predev": "convex init && bun run codegen",
    "codegen": "bunx convex codegen --component-dir ./src/component",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "check": "bun run test && bun run typecheck && bun run lint",
    "preversion": "bun install --frozen-lockfile && bun run check",
    "version": "vim -c 'normal o' -c 'normal o## '$(bun -p \"require('./package.json').version\") CHANGELOG.md && prettier -w CHANGELOG.md && git add CHANGELOG.md"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./_generated/component.js": {
      "types": "./src/component/_generated/component.ts",
      "default": "./src/component/_generated/component.ts"
    },
    "./convex.config.js": {
      "types": "./src/component/convex.config.ts",
      "default": "./src/component/convex.config.ts"
    }
  },
  "peerDependencies": {
    "convex": "^1.29.3",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@clerk/clerk-react": "5.61.3",
    "@convex-dev/eslint-plugin": "2.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/analytics": "2.0.1",
    "@vitejs/plugin-react": "6.0.1",
    "chokidar-cli": "3.0.0",
    "convex": "1.36.1",
    "convex-test": "0.0.50",
    "eslint": "10.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "stripe": "^22.1.0"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "esbuild"
  ]
}
